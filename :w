from lxml import etree

class Serializacao(object):

    def gerar(self, nfse):
        self._nfse = nfse
        if not isinstance(nfse, list):
            self._nfse = [nfse]
        r = etree.Element("PedidoEnvioLoteRPS", 
                          nsmap={"xsd": "http://www.w3.org/2001/XMLSchema",
                                 "xsi": "http://www.w3.org/2001/XMLSchema-instance"},
                          xmlns="http://www.prefeitura.sp.gov.br/nfe")
        r.append(Cabecalho(self._nfse).element)
        return r

class Cabecalho(object):

    def __init__(self, nfse):
        self._nfse = nfse
        self._element = etree.Element("Cabecalho",
                                      xmlns="")
        self._element.attrib["Versao"] = "2"
        self._element.append(self._remetente)

    @property
    def _remetente(self):
        r = etree.Element("CPFCNPJRemetente")
        cnpj = etree.Element("CNPJ")
        cnpj.text = self._nfse['emitente']['cnpj']
        r.append(cnpj)
        return r

    @property
    def element(self):
        return self._element


         


